
float w = ch("../../width");
float l = ch("../../length");
float wh = ch("../../wall_height");
float fgh = ch("../../front_gable_height");
float rgh = ch("../../rear_gable_height");
int count = 28;
float th = 0.025;
float overlap = 0.02;

float max_gh = max(fgh, rgh);
float total_h = wh + max_gh;
float step_h = total_h / float(count);
float plank_h = step_h + overlap;

// Window A parameters (Side walls: 3 on left, 3 on right)
float winA_w = ch("../../winA_width");
float winA_h = ch("../../winA_height");
float winA_sill = ch("../../winA_sill_y");
float winA_top = winA_sill + winA_h;
float winA_sp = 1.60;
if (ch("../../winA_spacing") > 0.0) winA_sp = ch("../../winA_spacing");
float winA_z[] = array(-winA_sp, 0.0, winA_sp);

// Window B parameters (Gable walls: 1 front, 1 rear -> 2 total!)
float winB_w = ch("../../winB_width");
float winB_h = ch("../../winB_height");
float winB_sill = ch("../../winB_sill_y");
float winB_top = winB_sill + winB_h;

int piece = 0;

// 1. LEFT WALL (X = -w*0.5, normals face -X)
for (int k = 0; k < count; ++k) {
    float y_bot = float(k) * step_h;
    float y_top = y_bot + plank_h;
    if (y_bot >= wh) break;
    if (y_top > wh) y_top = wh;
    
    float x_bot = -w * 0.5 - th;
    float x_top = -w * 0.5;
    
    int hits_win = 0;   // 8 October 2026 : window openings are cut exactly by boolean_window_cut in /obj/Church, planks stay whole
    
    if (!hits_win) {
        int pt0 = addpoint(0, set(x_bot, y_bot, -l*0.5));
        int pt1 = addpoint(0, set(x_top, y_top, -l*0.5));
        int pt2 = addpoint(0, set(x_top, y_top,  l*0.5));
        int pt3 = addpoint(0, set(x_bot, y_bot,  l*0.5));
        int pr = addprim(0, "poly", pt0, pt1, pt2, pt3);
        setprimattrib(0, "piece_id", pr, piece++);
        setprimgroup(0, "left_wall", pr, 1);
    } else {
        float z_splits[] = array(
            -l * 0.5,
            winA_z[0] - winA_w * 0.5,
            winA_z[0] + winA_w * 0.5,
            winA_z[1] - winA_w * 0.5,
            winA_z[1] + winA_w * 0.5,
            winA_z[2] - winA_w * 0.5,
            winA_z[2] + winA_w * 0.5,
             l * 0.5
        );
        for (int s = 0; s < 4; ++s) {
            float z0 = z_splits[s * 2];
            float z1 = z_splits[s * 2 + 1];
            int pt0 = addpoint(0, set(x_bot, y_bot, z0));
            int pt1 = addpoint(0, set(x_top, y_top, z0));
            int pt2 = addpoint(0, set(x_top, y_top, z1));
            int pt3 = addpoint(0, set(x_bot, y_bot, z1));
            int pr = addprim(0, "poly", pt0, pt1, pt2, pt3);
            setprimattrib(0, "piece_id", pr, piece++);
            setprimgroup(0, "left_wall", pr, 1);
        }
    }
}

// 2. RIGHT WALL (X = +w*0.5, normals face +X, 100% SYMMETRICAL)
for (int k = 0; k < count; ++k) {
    float y_bot = float(k) * step_h;
    float y_top = y_bot + plank_h;
    if (y_bot >= wh) break;
    if (y_top > wh) y_top = wh;
    
    float x_bot = w * 0.5 + th;
    float x_top = w * 0.5;
    
    int hits_win = 0;   // 8 October 2026 : window openings are cut exactly by boolean_window_cut in /obj/Church, planks stay whole
    
    if (!hits_win) {
        int pt0 = addpoint(0, set(x_bot, y_bot,  l*0.5));
        int pt1 = addpoint(0, set(x_top, y_top,  l*0.5));
        int pt2 = addpoint(0, set(x_top, y_top, -l*0.5));
        int pt3 = addpoint(0, set(x_bot, y_bot, -l*0.5));
        int pr = addprim(0, "poly", pt0, pt1, pt2, pt3);
        setprimattrib(0, "piece_id", pr, piece++);
        setprimgroup(0, "right_wall", pr, 1);
    } else {
        float z_splits[] = array(
            -l * 0.5,
            winA_z[0] - winA_w * 0.5,
            winA_z[0] + winA_w * 0.5,
            winA_z[1] - winA_w * 0.5,
            winA_z[1] + winA_w * 0.5,
            winA_z[2] - winA_w * 0.5,
            winA_z[2] + winA_w * 0.5,
             l * 0.5
        );
        for (int s = 0; s < 4; ++s) {
            float z0 = z_splits[s * 2];
            float z1 = z_splits[s * 2 + 1];
            int pt0 = addpoint(0, set(x_bot, y_bot, z1));
            int pt1 = addpoint(0, set(x_top, y_top, z1));
            int pt2 = addpoint(0, set(x_top, y_top, z0));
            int pt3 = addpoint(0, set(x_bot, y_bot, z0));
            int pr = addprim(0, "poly", pt0, pt1, pt2, pt3);
            setprimattrib(0, "piece_id", pr, piece++);
            setprimgroup(0, "right_wall", pr, 1);
        }
    }
}

// 3. FRONT GABLE WALL (Z = +l*0.5, normals face +Z, WITH WINDOW B - SYMMETRICAL TO REAR)
float peak_f = wh + fgh;
for (int k = 0; k < count; ++k) {
    float y_bot = float(k) * step_h;
    float y_top = y_bot + plank_h;
    if (y_bot >= peak_f) break;
    
    float z_bot = l * 0.5 + th;
    float z_top = l * 0.5;
    
    float x_half_bot = w * 0.5;
    float x_half_top = w * 0.5;
    
    if (y_bot > wh) {
        float frac = (y_bot - wh) / fgh;
        x_half_bot = w * 0.5 * clamp(1.0 - frac, 0.0, 1.0);
    }
    if (y_top > wh) {
        float frac = (y_top - wh) / fgh;
        x_half_top = w * 0.5 * clamp(1.0 - frac, 0.0, 1.0);
    }
    
    float door_cx = -0.38;
    float door_hw = 0.34;
    float door_bot = 0.60;
    float door_top = 1.85;
    
    int hits_door = (y_bot < door_top && y_top > door_bot);
    int hits_winB = 0;  // 8 October 2026 : gable window opening is cut exactly by boolean_window_cut
    
    if (hits_door) {
        float x_dl = door_cx - door_hw;
        float x_dr = door_cx + door_hw;
        // Left of doorway
        int pt0 = addpoint(0, set(-x_half_bot, y_bot, z_bot));
        int pt1 = addpoint(0, set(-x_half_top, y_top, z_top));
        int pt2 = addpoint(0, set( x_dl,       y_top, z_top));
        int pt3 = addpoint(0, set( x_dl,       y_bot, z_bot));
        int pr0 = addprim(0, "poly", pt0, pt1, pt2, pt3);
        setprimattrib(0, "piece_id", pr0, piece++);
        setprimgroup(0, "front_wall", pr0, 1);
        
        // Right of doorway
        int pt4 = addpoint(0, set( x_dr,       y_bot, z_bot));
        int pt5 = addpoint(0, set( x_dr,       y_top, z_top));
        int pt6 = addpoint(0, set( x_half_top, y_top, z_top));
        int pt7 = addpoint(0, set( x_half_bot, y_bot, z_bot));
        int pr1 = addprim(0, "poly", pt4, pt5, pt6, pt7);
        setprimattrib(0, "piece_id", pr1, piece++);
        setprimgroup(0, "front_wall", pr1, 1);
    } else if (hits_winB) {
        float hwb = winB_w * 0.5;
        // Left of Window B
        int pt0 = addpoint(0, set(-x_half_bot, y_bot, z_bot));
        int pt1 = addpoint(0, set(-x_half_top, y_top, z_top));
        int pt2 = addpoint(0, set(-hwb,        y_top, z_top));
        int pt3 = addpoint(0, set(-hwb,        y_bot, z_bot));
        int pr0 = addprim(0, "poly", pt0, pt1, pt2, pt3);
        setprimattrib(0, "piece_id", pr0, piece++);
        setprimgroup(0, "front_wall", pr0, 1);
        
        // Right of Window B
        int pt4 = addpoint(0, set( hwb,        y_bot, z_bot));
        int pt5 = addpoint(0, set( hwb,        y_top, z_top));
        int pt6 = addpoint(0, set( x_half_top, y_top, z_top));
        int pt7 = addpoint(0, set( x_half_bot, y_bot, z_bot));
        int pr1 = addprim(0, "poly", pt4, pt5, pt6, pt7);
        setprimattrib(0, "piece_id", pr1, piece++);
        setprimgroup(0, "front_wall", pr1, 1);
    } else {
        int pt0 = addpoint(0, set(-x_half_bot, y_bot, z_bot));
        int pt1 = addpoint(0, set(-x_half_top, y_top, z_top));
        int pt2 = addpoint(0, set( x_half_top, y_top, z_top));
        int pt3 = addpoint(0, set( x_half_bot, y_bot, z_bot));
        int pr = addprim(0, "poly", pt0, pt1, pt2, pt3);
        setprimattrib(0, "piece_id", pr, piece++);
        setprimgroup(0, "front_wall", pr, 1);
    }
}

// 4. REAR GABLE WALL (Z = -l*0.5, normals face -Z, WITH WINDOW B - SYMMETRICAL TO FRONT)
float peak_r = wh + rgh;
for (int k = 0; k < count; ++k) {
    float y_bot = float(k) * step_h;
    float y_top = y_bot + plank_h;
    if (y_bot >= peak_r) break;
    
    float z_bot = -l * 0.5 - th;
    float z_top = -l * 0.5;
    
    float x_half_bot = w * 0.5;
    float x_half_top = w * 0.5;
    
    if (y_bot > wh) {
        float frac = (y_bot - wh) / rgh;
        x_half_bot = w * 0.5 * clamp(1.0 - frac, 0.0, 1.0);
    }
    if (y_top > wh) {
        float frac = (y_top - wh) / rgh;
        x_half_top = w * 0.5 * clamp(1.0 - frac, 0.0, 1.0);
    }
    
    int hits_winB = 0;  // 8 October 2026 : gable window opening is cut exactly by boolean_window_cut
    
    if (!hits_winB) {
        int pt0 = addpoint(0, set( x_half_bot, y_bot, z_bot));
        int pt1 = addpoint(0, set( x_half_top, y_top, z_top));
        int pt2 = addpoint(0, set(-x_half_top, y_top, z_top));
        int pt3 = addpoint(0, set(-x_half_bot, y_bot, z_bot));
        int pr = addprim(0, "poly", pt0, pt1, pt2, pt3);
        setprimattrib(0, "piece_id", pr, piece++);
        setprimgroup(0, "rear_wall", pr, 1);
    } else {
        float hwb = winB_w * 0.5;
        // Right side looking at rear wall (+X)
        int pt0 = addpoint(0, set( x_half_bot, y_bot, z_bot));
        int pt1 = addpoint(0, set( x_half_top, y_top, z_top));
        int pt2 = addpoint(0, set( hwb,        y_top, z_top));
        int pt3 = addpoint(0, set( hwb,        y_bot, z_bot));
        int pr0 = addprim(0, "poly", pt0, pt1, pt2, pt3);
        setprimattrib(0, "piece_id", pr0, piece++);
        setprimgroup(0, "rear_wall", pr0, 1);
        
        // Left side looking at rear wall (-X)
        int pt4 = addpoint(0, set(-hwb,        y_bot, z_bot));
        int pt5 = addpoint(0, set(-hwb,        y_top, z_top));
        int pt6 = addpoint(0, set(-x_half_top, y_top, z_top));
        int pt7 = addpoint(0, set(-x_half_bot, y_bot, z_bot));
        int pr1 = addprim(0, "poly", pt4, pt5, pt6, pt7);
        setprimattrib(0, "piece_id", pr1, piece++);
        setprimgroup(0, "rear_wall", pr1, 1);
    }
}
