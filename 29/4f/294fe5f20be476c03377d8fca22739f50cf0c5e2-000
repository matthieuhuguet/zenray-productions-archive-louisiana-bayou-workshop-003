PW = 1380
def panel(keys, tex, title):
    base = Image.open(os.path.join(tex_dir, tex)).convert('RGB').resize((PW, PW)); base = Image.blend(base, Image.new('RGB', (PW, PW), (20, 20, 22)), 0.55)
    ov = Image.new('RGBA', (PW, PW), (0, 0, 0, 0)); d = ImageDraw.Draw(ov); n = 0
    for f in sorted([f for f in faces if f['k'] in keys], key=lambda f: -count[f['k']]):
        uv = np.array(f['UV'])
        if len(uv) < 3: continue
        uv = uv - np.floor(uv.mean(axis=0))
        pts = [(float(u) * PW, (1 - float(v)) * PW) for u, v in uv]
        c = col(f); d.polygon(pts, fill=c + (150,), outline=c + (255,)); n += 1
    im = Image.alpha_composite(base.convert('RGBA'), ov).convert('RGB'); ImageDraw.Draw(im).text((18, 14), title + '  (%d faces)' % n, fill=(255, 255, 255), font=SANS(36), stroke_width=2, stroke_fill=(0, 0, 0))
    return im
