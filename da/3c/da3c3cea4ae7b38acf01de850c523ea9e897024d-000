  "cutter_points_A": {
    "python": "# 8 October 2026 : one point per window opening. EN: the points copy the placement of the real window instances (same tx ty tz ry), so the wall cut follows any window count or church length. FR : un point par ouverture, meme placement que les fenetres.\nimport hou\ngeo = hou.pwd().geometry(); church = hou.node('/obj/Church')\nKIND = 'A'\npts = []\nif KIND == 'A':\n    wa = church.node('Component_WindowA'); n = wa.parm('num_side_windows').eval()\n    idx = {4: [0, 1, 2, 3], 3: [0, 1, 2], 2: [0, 2], 1: [1]}.get(n, [0, 1, 2])\n    for side in ('left', 'right'):\n        for i in idx:\n            nd = wa.node('%s_%d' % (side, i)); pts.append(tuple(nd.parm(k).eval() for k in ('tx', 'ty', 'tz', 'ry')))\nelse:\n    wb = church.node('Component_WindowB'); n = wb.parm('num_windows').eval() if wb.parm('num_windows') else 2\n    for nm in ('place_rear_gable', 'place_front_gable'):\n        nd = wb.node(nm); pts.append(tuple(nd.parm(k).eval() for k in ('tx', 'ty', 'tz', 'ry')))\ngeo.addAttrib(hou.attribType.Point, 'orient', (0.0, 0.0, 0.0, 1.0))\nfor tx, ty, tz, ry in pts:\n    p = geo.createPoint(); p.setPosition((tx, ty, tz))\n    q = hou.Quaternion(); q.setToAngleAxis(ry, (0, 1, 0)); p.setAttribValue('orient', tuple(q))\n",
    "maintainstate": 0
  },
