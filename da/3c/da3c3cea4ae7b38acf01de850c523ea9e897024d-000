    "snippet": "\nvoid make_symmetric_wedge_shingle(vector center; float L, W, T_butt, T_head; matrix3 rot; string grp_name; int pid) {\n    float hx = L * 0.5;\n    float hz = W * 0.5;\n    \n    vector p[];\n    resize(p, 8);\n    p[0] = center + set(-hx, 0.0,    -hz) * rot;\n    p[1] = center + set( hx, 0.0,    -hz) * rot;\n    p[2] = center + set( hx, 0.0,     hz) * rot;\n    p[3] = center + set(-hx, 0.0,     hz) * rot;\n    p[4] = center + set(-hx, T_butt, -hz) * rot;\n    p[5] = center + set( hx, T_head, -hz) * rot;\n    p[6] = center + set( hx, T_head,  hz) * rot;\n    p[7] = center + set(-hx, T_butt,  hz) * rot;\n    \n    // Left side shingle (strictly outward normals)\n    int ipt_l[];\n    resize(ipt_l, 8);\n    for (int k = 0; k < 8; ++k) ipt_l[k] = addpoint(0, p[k]);\n    \n    int pr0 = addprim(0, \"poly\", ipt_l[5], ipt_l[6], ipt_l[7], ipt_l[4]); // Top (+Y outward)\n    int pr1 = addprim(0, \"poly\", ipt_l[3], ipt_l[2], ipt_l[1], ipt_l[0]); // Bottom (-Y outward)\n    int pr2 = addprim(0, \"poly\", ipt_l[4], ipt_l[7], ipt_l[3], ipt_l[0]); // Butt (-X outward)\n    int pr3 = addprim(0, \"poly\", ipt_l[2], ipt_l[6], ipt_l[5], ipt_l[1]); // Head (+X outward)\n    int pr4 = addprim(0, \"poly\", ipt_l[1], ipt_l[5], ipt_l[4], ipt_l[0]); // -Z outward\n    int pr5 = addprim(0, \"poly\", ipt_l[7], ipt_l[6], ipt_l[2], ipt_l[3]); // +Z outward\n    \n    int prims_l[] = array(pr0, pr1, pr2, pr3, pr4, pr5);\n    foreach (int pr; prims_l) {\n        setprimgroup(0, grp_name, pr, 1);\n        setprimattrib(0, \"piece_id\", pr, pid);\n    }\n    \n    // Right side shingle (mirrored across X=0 with strictly outward normals)\n    int ipt_r[];\n    resize(ipt_r, 8);\n    for (int k = 0; k < 8; ++k) {\n        vector pr_pos = set(-p[k].x, p[k].y, p[k].z);\n        ipt_r[k] = addpoint(0, pr_pos);\n    }\n    \n    int r0 = addprim(0, \"poly\", ipt_r[7], ipt_r[6], ipt_r[5], ipt_r[4]); // Top (+Y outward)\n    int r1 = addprim(0, \"poly\", ipt_r[0], ipt_r[1], ipt_r[2], ipt_r[3]); // Bottom (-Y outward)\n    int r2 = addprim(0, \"poly\", ipt_r[0], ipt_r[3], ipt_r[7], ipt_r[4]); // Butt (+X outward)\n    int r3 = addprim(0, \"poly\", ipt_r[1], ipt_r[5], ipt_r[6], ipt_r[2]); // Head (-X outward)\n    int r4 = addprim(0, \"poly\", ipt_r[0], ipt_r[4], ipt_r[5], ipt_r[1]); // -Z outward\n    int r5 = addprim(0, \"poly\", ipt_r[3], ipt_r[2], ipt_r[6], ipt_r[7]); // +Z outward\n    \n    int prims_r[] = array(r0, r1, r2, r3, r4, r5);\n    foreach (int pr; prims_r) {\n        setprimgroup(0, grp_name, pr, 1);\n        setprimattrib(0, \"piece_id\", pr, pid + 10000);\n    }\n}\nfloat w = ch(\"../width\");\nfloat l = ch(\"../length\");\nfloat wh = ch(\"../wall_height\");\nfloat gh = ch(\"../gable_height\");\nfloat peak_y = wh + gh;\n\nfloat eave_oh = ch(\"../eave_overhang\");\nfloat gable_oh = ch(\"../gable_overhang\");\nfloat total_len = l + gable_oh * 2.0;\n\nfloat half_w = w * 0.5 + eave_oh;\nfloat slope_len = sqrt(half_w * half_w + gh * gh);\nfloat pitch_angle = atan2(gh, half_w);\nfloat cos_p = cos(pitch_angle);\nfloat sin_p = sin(pitch_angle);\n\nfloat rot_rand   = ch(\"../shingle_rot_random\");\nfloat slope_tilt = ch(\"../shingle_slope_tilt\");\n\nint num_rows = chi(\"../shingle_rows\");\nif (num_rows < 2) num_rows = 2;\nint num_cols = chi(\"../shingle_cols\");\nif (num_cols < 2) num_cols = 2;\nfloat overlap = ch(\"../shingle_overlap\");\nfloat sh_thick = ch(\"../shingle_thickness\");\nfloat head_thick = max(0.003, sh_thick * 0.23);\n\nfloat row_step = slope_len / float(num_rows);\nfloat base_sh_len = row_step + overlap;\nfloat col_w = total_len / float(num_cols);\n\nint pid = 1000;\n\nvector dir_up_l = set( cos_p,  sin_p, 0.0);\nvector norm_l   = set(-sin_p,  cos_p, 0.0);\nvector eave_l   = set(-half_w, wh, 0.0);\n\nmatrix3 rot_l = ident();\nrotate(rot_l, pitch_angle, set(0, 0, 1));\n\nfloat base_tilt = 1.8 + slope_tilt;\n\nfloat z_min_allowed = -total_len * 0.5 - 0.025;\nfloat z_max_allowed =  total_len * 0.5 + 0.025;\n\nfloat max_slope_limit = slope_len - 0.05;\n\n// Supprimer UNIQUEMENT la derniere ligne des tuiles du haut (r < num_rows - 1)\nfor (int r = 0; r < num_rows - 1; ++r) {\n    float dist = float(r) * row_step;\n    \n    if (dist >= max_slope_limit - 0.04) continue;\n    \n    float z_offset = (r % 2 == 1) ? (col_w * 0.5) : 0.0;\n    \n    for (int c = -1; c <= num_cols; ++c) {\n        float z_center = -total_len * 0.5 + float(c) * col_w + col_w * 0.5 + z_offset;\n        \n        float seed = float(r * 157 + (c + 2) * 43 + 9181);\n        \n        float raw_len = base_sh_len + (rand(seed + 1.1) - 0.5) * 0.015;\n        float j_len = min(raw_len, max_slope_limit - dist);\n        if (j_len < 0.08) continue;\n        \n        float j_thick_butt = sh_thick * (0.94 + 0.12 * rand(seed + 2.3));\n        float j_thick_head = head_thick * (0.94 + 0.12 * rand(seed + 3.7));\n        float raw_width = col_w * 0.95 + (rand(seed + 4.9) - 0.5) * 0.006;\n        float j_z = (rand(seed + 5.1) - 0.5) * 0.004;\n        \n        float z_min = max(z_min_allowed, z_center - raw_width * 0.5);\n        float z_max = min(z_max_allowed, z_center + raw_width * 0.5);\n        if (z_max <= z_min + 0.035) continue;\n        \n        float j_width = z_max - z_min;\n        float final_z = (z_min + z_max) * 0.5 + j_z;\n        \n        float j_tilt = (rand(seed + 6.3) - 0.5) * rot_rand * 0.25;\n        float j_yaw  = (rand(seed + 7.5) - 0.5) * rot_rand * 0.40;\n        \n        float sh_tilt = max(0.2, base_tilt + j_tilt);\n        float eave_adjust = (r == 0) ? -0.040 : 0.0;\n        \n        float head_elev = 0.004;\n        float elev = head_elev + (j_len * 0.5) * sin(radians(sh_tilt));\n        \n        vector pos = eave_l + dir_up_l * (dist + j_len * 0.5 + eave_adjust) + norm_l * elev;\n        pos.z = final_z;\n        \n        matrix3 rot_sh = rot_l;\n        rotate(rot_sh, -radians(sh_tilt), set(0, 0, 1));\n        rotate(rot_sh, radians(j_yaw), set(0, 1, 0));\n        \n        make_symmetric_wedge_shingle(pos, j_len, j_width, j_thick_butt, j_thick_head, rot_sh, \"group_shingles\", pid++);\n    }\n}\n",
