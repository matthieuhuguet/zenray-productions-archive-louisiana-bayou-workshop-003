{"snippet": "\nfloat w = ch(\"../width\");\nfloat l = ch(\"../length\");\nfloat wh = ch(\"../wall_height\");\nfloat fgh = ch(\"../front_gable_height\");\nfloat rgh = ch(\"../rear_gable_height\");\nfloat arch_deg = ch(\"../arch_angle\");\nfloat cross_h = ch(\"../cross_height\");\n\nfloat z_front = l * 0.5;\nfloat z_rear = -l * 0.5;\nfloat x_left = -w * 0.5;\nfloat x_right = w * 0.5;\n\nfloat gables_h[] = array(fgh, rgh);\nfloat gables_z[] = array(z_front, z_rear);\n\nfloat theta = radians(clamp(arch_deg, 5.0, 89.0));\n\nfor (int g = 0; g < 2; ++g) {\n    float gh = gables_h[g];\n    float z = gables_z[g];\n    float peak_y = wh + gh;\n    \n    // Corner eave points\n    int pt_left = addpoint(0, set(x_left, wh, z));\n    int pt_right = addpoint(0, set(x_right, wh, z));\n    int pt_peak = addpoint(0, set(0, peak_y, z));\n    \n    // Rafters\n    int r_l = addprim(0, \"polyline\"); addvertex(0, r_l, pt_left); addvertex(0, r_l, pt_peak);\n    int r_r = addprim(0, \"polyline\"); addvertex(0, r_r, pt_right); addvertex(0, r_r, pt_peak);\n    \n    // King post drop from apex: ~52% of gable height\n    float king_drop = gh * 0.30;\n    float y_king = peak_y - king_drop; // junction where curved braces meet king post\n    float y_pendant = y_king - 0.12;   // pendant tip extends slightly below junction\n    \n    int pt_pendant = addpoint(0, set(0, y_pendant, z));\n    int p_king = addprim(0, \"polyline\"); addvertex(0, p_king, pt_peak); addvertex(0, p_king, pt_pendant);\n    \n    // Circular arc radius R so that endpoint at angle theta hits the rafter exactly:\n    float slope = (2.0 * gh) / w;\n    float denom = sin(theta) + slope * (1.0 - cos(theta));\n    float R = (denom > 0.001) ? (king_drop / denom) : (king_drop * 0.5);\n    \n    int num_segs = 24;\n    \n    // Left circular arch brace: tangent to king post at (0, y_king), curves up and out to rafter\n    int prim_arch_l = addprim(0, \"polyline\");\n    for (int i = 0; i <= num_segs; ++i) {\n        float u = float(i) / float(num_segs); // 0 at king post, 1 at rafter\n        float phi = u * theta;\n        float x = -R * (1.0 - cos(phi));\n        float y = y_king + R * sin(phi);\n        int pt = addpoint(0, set(x, y, z));\n        addvertex(0, prim_arch_l, pt);\n    }\n    \n    // Right circular arch brace: symmetrical\n    int prim_arch_r = addprim(0, \"polyline\");\n    for (int i = 0; i <= num_segs; ++i) {\n        float u = float(i) / float(num_segs);\n        float phi = u * theta;\n        float x = R * (1.0 - cos(phi));\n        float y = y_king + R * sin(phi);\n        int pt = addpoint(0, set(x, y, z));\n        addvertex(0, prim_arch_r, pt);\n    }\n}\n\n// Single cross on the front gable apex (Z = z_front)\nfloat peak_y = wh + fgh;\nfloat z = z_front + 0.05; // Placed proudly on front gable timber\nint c_base = addpoint(0, set(0, peak_y, z));\nint c_top = addpoint(0, set(0, peak_y + cross_h, z));\nint prim_c_vert = addprim(0, \"polyline\"); addvertex(0, prim_c_vert, c_base); addvertex(0, prim_c_vert, c_top);\n\nfloat crossbar_y = peak_y + cross_h * 0.68;\nfloat crossbar_half_w = cross_h * 0.26;\nint c_bar_l = addpoint(0, set(-crossbar_half_w, crossbar_y, z));\nint c_bar_r = addpoint(0, set( crossbar_half_w, crossbar_y, z));\nint prim_c_bar = addprim(0, \"polyline\"); addvertex(0, prim_c_bar, c_bar_l); addvertex(0, prim_c_bar, c_bar_r);\n"}