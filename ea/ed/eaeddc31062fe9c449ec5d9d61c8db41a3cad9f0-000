# ---- mesh view : 3/4 from the outside (+z), painter's algorithm, flat shading
def view(yaw_deg, pitch_deg, label):
    yaw, pit = math.radians(yaw_deg), math.radians(pitch_deg)
    R = np.array([[math.cos(yaw), 0, math.sin(yaw)], [0, 1, 0], [-math.sin(yaw), 0, math.cos(yaw)]]) @ np.array([[1, 0, 0], [0, math.cos(pit), -math.sin(pit)], [0, math.sin(pit), math.cos(pit)]])
    allp = np.array([p for f in data for p in f['P']]); c = allp.mean(0)
    cam = (allp - c) @ R           # rotate the cloud: view from +z after rotation
    polys = []
    for f in data:
        P = (np.array(f['P']) - c) @ R
        n = np.cross(P[1] - P[0], P[2] - P[0]); nn = np.linalg.norm(n)
        shade = 0.55 + 0.45 * abs(n[2] / nn) if nn > 1e-12 else 0.7
        polys.append((P[:, 2].mean() + (0.0 if f.get('uv') else -1000.0 * 0 ), P, f['Cd'], shade))  # COLOURED_ON_TOP : see below
    polys.sort(key=lambda t: t[0])
    if os.environ.get('UNTEXTURED_FIRST'):
        polys.sort(key=lambda t: (0 if tuple(t[2]) == (0.42, 0.42, 0.44) else 1, t[0]))
    ext = np.abs(cam[:, :2]).max(); s = PX * 0.44 / ext
    im = Image.new('RGB', (PX, PX), (28, 28, 30)); d = ImageDraw.Draw(im)
    for z, P, col, sh in polys:
        pts = [(PX / 2 + p[0] * s, PX / 2 - p[1] * s) for p in P]
        d.polygon(pts, fill=tuple(int(255 * min(1, c_ * sh)) for c_ in col), outline=(15, 15, 15))
    d.text((14, 12), label, fill=(235, 235, 235), font=FONT)
    return im
