# 9 October 2026 : repair stretched UV faces. EN: measure for every face the ratio of the two singular values of the uv -> world map; a face above LIMIT is mapped again in its own plane (u along its longest edge, v across) with the density of its material, and kept inside the plank band it already sat in, so nothing leaves its band. Balls are left to their wrap. FR : réparer les faces étirées : repère propre à la face, même bande de planche, densité du matériau.
import hou, math
import numpy as np
geo = hou.pwd().geometry()
LIMIT = globals().get('STRETCH_LIMIT', 2.2)
GROOVES = [0.077, 0.195, 0.313, 0.435, 0.553, 0.671, 0.787, 0.897]; MARGIN_V = 0.010; UV_PER_M = 0.63
SEAMS_LOUVER = [0.0, 0.111, 0.212, 0.313, 0.421]
def stretch(P, U):
    dP = np.stack([P[1] - P[0], P[2] - P[0]], axis=1); dU = np.stack([U[1] - U[0], U[2] - U[0]], axis=1)
    if abs(np.linalg.det(dU)) < 1e-12: return 1e9
    s = np.linalg.svd(dP @ np.linalg.inv(dU), compute_uv=False); return s[0] / max(s[1], 1e-12)
def frame(P, n):
    best, e = -1.0, None
    for i in range(len(P)):
        d = P[(i + 1) % len(P)] - P[i]; l = np.linalg.norm(d)
        if l > best: best, e = l, d
    eu = e / max(np.linalg.norm(e), 1e-12); ev = np.cross(n, eu); return eu, ev / max(np.linalg.norm(ev), 1e-12)
fixed = 0; before = []
for pr in geo.prims():
    grp = pr.attribValue('grp'); part = pr.attribValue('stair_part') if geo.findPrimAttrib('stair_part') else ''
    if part == 'ball' or grp == 'glass': continue      # glass is another material, its uv stays parked at 0
    vs = list(pr.vertices())
    if len(vs) < 3: continue
    P = np.array([v.point().position() for v in vs], float); U = np.array([list(v.attribValue('uv'))[:2] for v in vs], float)
    r = stretch(P[:3], U[:3])
    if r <= LIMIT: continue
    n = np.array(pr.normal())
    if np.linalg.norm(n) < 1e-9: continue
    eu, ev = frame(P, n); a = P @ eu; b = P @ ev; cu, cv = U.mean(axis=0)
    paint = grp.startswith('paint')
    if paint:
        k = min(range(len(GROOVES) - 1), key=lambda i: abs((GROOVES[i] + GROOVES[i + 1]) / 2 - cv)); lo, hi = GROOVES[k] + MARGIN_V, GROOVES[k + 1] - MARGIN_V; D = UV_PER_M
    elif grp in ('slat_L', 'slat_R'):
        k = min(range(4), key=lambda i: abs((SEAMS_LOUVER[i] + SEAMS_LOUVER[i + 1]) / 2 - cv)); lo, hi = SEAMS_LOUVER[k] + 0.012, SEAMS_LOUVER[k + 1] - 0.012; D = 0.8
    else:
        lo, hi = cv - 0.05, cv + 0.05; D = UV_PER_M
    h = max(np.ptp(b), 1e-6)
    D = min(D, (hi - lo) / h)
    for v, ai, bi in zip(vs, a, b):
        u = cu + (ai - a.mean()) * D; w = (lo + hi) / 2 + (bi - b.mean()) * D
        v.setAttribValue('uv', (float(u), float(min(max(w, lo), hi)), 0.0))
    fixed += 1
geo.addAttrib(hou.attribType.Global, 'stretch_fixed', fixed) if geo.findGlobalAttrib('stretch_fixed') is None else geo.setGlobalAttribValue('stretch_fixed', fixed)
