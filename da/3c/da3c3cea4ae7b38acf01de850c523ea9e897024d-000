    "vex_numcount": 10,
    "vex_threadjobsize": 1024,
    "snippet": "\n// 8 October 2026 : siding with EXACT openings. EN: every clapboard row is cut analytically around the windows and the door (left, right, below the sill, above the lintel), so no boolean is needed and every piece stays a clean quad. The row count is multiplied by plank_multiplier (x1 = the old 28 rows, x2, x3). FR : ouvertures exactes, plus de boolean, nombre de planches multiplie.\nint addq(vector a; vector b; vector c; vector d; int rid; string grp) {\n    int p0 = addpoint(0, a); int p1 = addpoint(0, b); int p2 = addpoint(0, c); int p3 = addpoint(0, d);\n    int pr = addprim(0, \"poly\", p0, p1, p2, p3);\n    setprimattrib(0, \"piece_id\", pr, pr);\n    setprimattrib(0, \"plank_row\", pr, rid);\n    setprimgroup(0, grp, pr, 1);\n    return pr;\n}\nvoid sq(int flip; float xb; float xt; float yb; float yt; float ya; float yc; float z0; float z1; int rid; string grp) {\n    if (z1 - z0 < 0.0001 || yc - ya < 0.0001) return;\n    float ta = (ya - yb) / max(yt - yb, 0.000001); float tc = (yc - yb) / max(yt - yb, 0.000001);\n    float xa = lerp(xb, xt, ta); float xc = lerp(xb, xt, tc);\n    if (flip == 0) addq(set(xa, ya, z0), set(xc, yc, z0), set(xc, yc, z1), set(xa, ya, z1), rid, grp);\n    else addq(set(xa, ya, z1), set(xc, yc, z1), set(xc, yc, z0), set(xa, ya, z0), rid, grp);\n}\nvoid side_row(int flip; float xb; float xt; float yb; float yt; float l; float wz[]; float hw; float oy0; float oy1; int rid; string grp) {\n    float cur = -l * 0.5;\n    if (yb < oy1 && yt > oy0) {\n        for (int i = 0; i < len(wz); ++i) {\n            float z0 = wz[i] - hw; float z1 = wz[i] + hw;\n            sq(flip, xb, xt, yb, yt, yb, yt, cur, z0, rid, grp);                          // column left of the window, full row\n            if (yb < oy0) sq(flip, xb, xt, yb, yt, yb, min(yt, oy0), z0, z1, rid, grp);   // under the sill\n            if (yt > oy1) sq(flip, xb, xt, yb, yt, max(yb, oy1), yt, z0, z1, rid, grp);   // over the lintel\n            cur = z1;\n        }\n    }\n    sq(flip, xb, xt, yb, yt, yb, yt, cur, l * 0.5, rid, grp);\n}\nvoid gq(int flip; float zb; float zt; float yb; float yt; float hb; float ht; float ya; float yc; float x0; float x1; int rid; string grp) {\n    if (yc - ya < 0.0001) return;\n    float ta = (ya - yb) / max(yt - yb, 0.000001); float tc = (yc - yb) / max(yt - yb, 0.000001);\n    float ha = lerp(hb, ht, ta); float hc = lerp(hb, ht, tc);\n    float xla = max(x0, -ha); float xra = min(x1, ha); float xlc = max(x0, -hc); float xrc = min(x1, hc);\n    if (xra - xla < 0.0001 && xrc - xlc < 0.0001) return;\n    float za = lerp(zb, zt, ta); float zc = lerp(zb, zt, tc);\n    if (flip == 0) addq(set(xla, ya, za), set(xlc, yc, zc), set(xrc, yc, zc), set(xra, ya, za), rid, grp);\n    else addq(set(xra, ya, za), set(xrc, yc, zc), set(xlc, yc, zc), set(xla, ya, za), rid, grp);\n}\nvoid gable_row(int flip; float zb; float zt; float yb; float yt; float hb; float ht; float ox0[]; float ox1[]; float oy0[]; float oy1[]; int rid; string grp) {\n    float cur = -1000000.0;\n    for (int i = 0; i < len(ox0); ++i) {\n        if (yb < oy1[i] && yt > oy0[i]) {\n            gq(flip, zb, zt, yb, yt, hb, ht, yb, yt, cur, ox0[i], rid, grp);\n            if (yb < oy0[i]) gq(flip, zb, zt, yb, yt, hb, ht, yb, min(yt, oy0[i]), ox0[i], ox1[i], rid, grp);\n            if (yt > oy1[i]) gq(flip, zb, zt, yb, yt, hb, ht, max(yb, oy1[i]), yt, ox0[i], ox1[i], rid, grp);\n            cur = ox1[i];\n        }\n    }\n    gq(flip, zb, zt, yb, yt, hb, ht, yb, yt, cur, 1000000.0, rid, grp);\n}\n\nfloat w = ch(\"../../width\");\nfloat l = ch(\"../../length\");\nfloat wh = ch(\"../../wall_height\");\nfloat fgh = ch(\"../../front_gable_height\");\nfloat rgh = ch(\"../../rear_gable_height\");\nint mult = chi(\"../../plank_multiplier\") + 1;     // menu index 0,1,2 = x1 (old 28 rows), x2 (default), x3 (finest)\nint count = 28 * mult;\nfloat th = 0.025;\nfloat overlap = 0.02 / float(mult);\nfloat max_gh = max(fgh, rgh);\nfloat total_h = wh + max_gh;\nfloat step_h = total_h / float(count);\nfloat plank_h = step_h + overlap;\n\nfloat winA_w = ch(\"../../winA_width\");\nfloat winA_h = ch(\"../../winA_height\");\nfloat winA_sill = ch(\"../../winA_sill_y\");\nfloat winA_sp = 1.60;\nif (ch(\"../../winA_spacing\") > 0.0) winA_sp = ch(\"../../winA_spacing\");\nint nwin = chi(\"../../Component_WindowA/num_side_windows\");\nfloat winA_z[];\nif (nwin == 4) winA_z = array(-1.5 * winA_sp, -0.5 * winA_sp, 0.5 * winA_sp, 1.5 * winA_sp);\nelse if (nwin == 2) winA_z = array(-winA_sp, winA_sp);\nelse if (nwin == 1) winA_z = array(0.0);\nelse winA_z = array(-winA_sp, 0.0, winA_sp);\nfloat hwA = winA_w * 0.5 - 0.02;\nfloat winB_w = ch(\"../../winB_width\");\nfloat winB_h = ch(\"../../winB_height\");\nfloat winB_sill = ch(\"../../winB_sill_y\");\nfloat hwB = winB_w * 0.5 - 0.025;\n\n// 1. LEFT WALL (X = -w/2) and 2. RIGHT WALL (X = +w/2)\nfor (int k = 0; k < count; ++k) {\n    float y_bot = float(k) * step_h;\n    float y_top = min(y_bot + plank_h, wh);\n    if (y_bot >= wh) break;\n    side_row(0, -w * 0.5 - th, -w * 0.5, y_bot, y_top, l, winA_z, hwA, winA_sill, winA_sill + winA_h, k, \"left_wall\");\n    side_row(1,  w * 0.5 + th,  w * 0.5, y_bot, y_top, l, winA_z, hwA, winA_sill, winA_sill + winA_h, 100000 + k, \"right_wall\");\n}\n\n// 3. FRONT GABLE (Z = +l/2) : door and window B\nfloat door_cx = -0.38; float door_hw = 0.34; float door_bot = 0.60; float door_top = 1.85;\nfloat f_ox0[] = array(door_cx - door_hw, -hwB);\nfloat f_ox1[] = array(door_cx + door_hw,  hwB);\nfloat f_oy0[] = array(door_bot, winB_sill);\nfloat f_oy1[] = array(door_top, winB_sill + winB_h);\nfloat r_ox0[] = array(-hwB); float r_ox1[] = array(hwB); float r_oy0[] = array(winB_sill); float r_oy1[] = array(winB_sill + winB_h);\nfloat peak_f = wh + fgh;\nfor (int k = 0; k < count; ++k) {\n    float y_bot = float(k) * step_h; float y_top = y_bot + plank_h;\n    if (y_bot >= peak_f) break;\n    float hb = w * 0.5; float ht = w * 0.5;\n    if (y_bot > wh) hb = w * 0.5 * clamp(1.0 - (y_bot - wh) / fgh, 0.0, 1.0);\n    if (y_top > wh) ht = w * 0.5 * clamp(1.0 - (y_top - wh) / fgh, 0.0, 1.0);\n    gable_row(0, l * 0.5 + th, l * 0.5, y_bot, y_top, hb, ht, f_ox0, f_ox1, f_oy0, f_oy1, 200000 + k, \"front_wall\");\n}\n\n// 4. REAR GABLE (Z = -l/2) : window B\nfloat peak_r = wh + rgh;\nfor (int k = 0; k < count; ++k) {\n    float y_bot = float(k) * step_h; float y_top = y_bot + plank_h;\n    if (y_bot >= peak_r) break;\n    float hb = w * 0.5; float ht = w * 0.5;\n    if (y_bot > wh) hb = w * 0.5 * clamp(1.0 - (y_bot - wh) / rgh, 0.0, 1.0);\n    if (y_top > wh) ht = w * 0.5 * clamp(1.0 - (y_top - wh) / rgh, 0.0, 1.0);\n    gable_row(1, -l * 0.5 - th, -l * 0.5, y_bot, y_top, hb, ht, r_ox0, r_ox1, r_oy0, r_oy1, 300000 + k, \"rear_wall\");\n}\n",
